# 单机部署环境模板 · cp .env.example .env 后填入强随机值（.env 不入库，E11/secretcheck 口径）
# 密钥正本体系与 dev 同源：MICRO_DEV_* 中间件凭据 + keys.json 派生数据密钥（见 tools/devenv.sh）

# —— 中间件凭据 ——
MICRO_DEV_MYSQL_ROOT_PW=<strong-password>
MICRO_DEV_MYSQL_APP_USER=micro_app
MICRO_DEV_MYSQL_APP_PW=<strong-password>
MICRO_DEV_REDIS_PW=<strong-password>
MICRO_DEV_TDENGINE_PW=<strong-password>
MICRO_DEV_EMQX_DASHBOARD_USER=<dashboard-user>
MICRO_DEV_EMQX_DASHBOARD_PW=<strong-password>
MICRO_DEV_EMQX_DEVICE_USER=<device-user>
MICRO_DEV_EMQX_DEVICE_PW=<strong-password>
MICRO_DEV_EMQX_PLATFORM_USER=<platform-user>
MICRO_DEV_EMQX_PLATFORM_PW=<strong-password>
MICRO_DEV_APISIX_ADMIN_KEY=<32-hex-admin-key>
MICRO_DEV_MINIO_ROOT_USER=<minio-user>
MICRO_DEV_MINIO_ROOT_PASSWORD=<strong-password>
MICRO_ADMIN_PW=<admin-login-password>
MICRO_HASH_KEY=<hmac-index-key>
MICRO_FILE_SIGN_KEY=<file-sign-key>
MOCKWX=1

# —— 数据密钥（tools/keygen 生成，见 micro-deploy/deploy/conf/keys/keys.json env_usage 段）——
MICRO_DATA_KEYS=<kid>=<base64-key>
MICRO_DATA_KEY_KID=<kid>

# —— 单机组网地址（容器网络内名，单机默认无需改）——
ETCD_HOSTS=http://etcd:2379
KAFKA_BROKERS=kafka:9092
REDIS_HOSTS=redis:6379
TDENGINE_REST=http://tdengine:6041
MICRO_DEV_TDENGINE_REST=http://tdengine:6041
MICRO_DEV_ETCD_HOSTS=etcd:2379
MICRO_DEV_KAFKA_BROKERS=kafka:9092
MICRO_DEV_MYSQL_HOST=mysql:3306
MICRO_DEV_REDIS_ADDR=redis:6379
MINIO_ENDPOINT=minio:9000
EMQX_BROKER=tcp://emqx:1883
EMQX_API_BASE=http://emqx:18083
JWT_KEYS_DIR=/keys
OTA_PUBLIC_KEY=/keys/ota_ed25519_public.pem

# —— 工具箱（tools/internal/devcfg 口径）——
REDIS_PASS=<同 MICRO_DEV_REDIS_PW>
TDENGINE_PASS=<同 MICRO_DEV_TDENGINE_PW>
MINIO_ACCESS_KEY=<同 MICRO_DEV_MINIO_ROOT_USER>
MINIO_SECRET_KEY=<同 MICRO_DEV_MINIO_ROOT_PASSWORD>
EMQX_DASHBOARD_USER=<同上>
EMQX_DASHBOARD_PASS=<同上>
EMQX_DEVICE_USER=<同上>
EMQX_DEVICE_PASS=<同上>
EMQX_PLATFORM_USER=<同上>
EMQX_PLATFORM_PASS=<同上>

# —— RPC 直连端点（tools/port_registry.txt 口径）——
IDENTITY_RPC=identity:8081
PARTY_RPC=party:8082
CATALOG_RPC=catalog:8083
INVENTORY_RPC=inventory:8084
DEVICE_RPC=device:8085
FILE_RPC=file:8086
AUDIT_RPC=audit:8087
NOTIFICATION_RPC=notification:8089
ORDER_RPC=order:8090
STATION_RPC=station:8091
FINANCE_RPC=finance:8092
CONTRACT_RPC=contract:8093
OPS_RPC=ops:8094
ANALYTICS_RPC=analytics:8095
HELLO_RPC=hello:8888
