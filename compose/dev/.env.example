# =====================================================================
# micro-dev 环境变量样例（S2-01，NFR-ENV-001）
# ---------------------------------------------------------------------
# 用法：cp .env.example .env，然后把所有空值替换为强随机密码（openssl rand -base64 24）。
# 红线：.env 已 gitignore（E11），真实密码永不入库；入库的只有本样例。
# 读取方：
#   1) docker compose（${MICRO_DEV_*} 插值 + env_file 注入容器）
#   2) micro-server 工具链（envcheck/migrate/seed/configpush 在 env 未设时回读本文件）
# 端口不在此文件——端口取号见 docker-compose.dev.yml 注释 / env.md / v4/02 §5.3（三处登记）。
# =====================================================================

# ---- profile 一处控制（core 日常；edge 设备联调；obs 看板/告警）----
COMPOSE_PROFILES=core,edge,obs

# ---- MySQL（双账号：root 仅人工运维；应用账号授权 micro_% 库）----
MICRO_DEV_MYSQL_ROOT_PW=
MICRO_DEV_MYSQL_APP_USER=micro_app
MICRO_DEV_MYSQL_APP_PW=

# ---- Redis（requirepass；DB0 缓存/DB1 预留/DB3 锁/DB4 会话）----
MICRO_DEV_REDIS_PW=

# ---- TDengine（首启脚本把 root 默认密码 taosdata 改成该值）----
MICRO_DEV_TDENGINE_PW=

# ---- EMQX（Dashboard 账号 + 设备联调平台账号，bootstrap.sh 幂等创建）----
MICRO_DEV_EMQX_DASHBOARD_USER=micro_admin
MICRO_DEV_EMQX_DASHBOARD_PW=
MICRO_DEV_EMQX_DEVICE_USER=micro-dev-device
MICRO_DEV_EMQX_DEVICE_PW=

# ---- APISIX（Admin API key，config.yaml 内 ${} 注入；仅回环绑定兜底）----
MICRO_DEV_APISIX_ADMIN_KEY=

# ---- MinIO（双桶 micro-file / micro-contract 由 minio-init 幂等创建）----
MICRO_DEV_MINIO_ROOT_USER=micro_minio
MICRO_DEV_MINIO_ROOT_PASSWORD=

# ---- Grafana（管理员账号，provisioning 数据源/看板免手配）----
MICRO_DEV_GRAFANA_ADMIN_USER=micro_admin
MICRO_DEV_GRAFANA_ADMIN_PASSWORD=

# ---- 以下仅供 micro-server 工具链读取（compose 不消费）----
# 种子管理员密码：tools/seed 读取，未设置时强告警并拒绝执行（S2-04）
MICRO_ADMIN_PW=
# 数据密钥（base64url 32B）：crypto.EnvKeyProviderFromEnv 消费（S1-05）；keygen 产出
#MICRO_DATA_KEYS=
#MICRO_DATA_KEY_KID=
# RS256/Ed25519 密钥目录（keygen -out 落点，gitignore）
#JWT_KEYS_DIR=../micro-deploy/deploy/conf/keys
