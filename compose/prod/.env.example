# .env.example · 阶段一生产（ECS-1 app / ECS-2 data 共用模板；真实 .env 不入库，E11）
# 密码纪律：与 dev 的 MICRO_DEV_* 区分，生产一律 MICRO_PROD_* / 无前缀强命名。

# ---- 镜像（IMAGE_TAG=git sha，CI 构建推送 GHCR） ----
IMAGE_TAG=latest

# ---- etcd（ECS-2 广播地址：必须是 ECS-1 可达的内网 IP，AGENTS 已知坑） ----
ETCD_HOSTS=http://10.0.0.2:2379

# ---- Kafka（E3：advertised 必须客户端可达） ----
KAFKA_ADVERTISED_HOST=10.0.0.2
KAFKA_BROKERS=10.0.0.2:29092

# ---- MySQL 云托管（B1 切换点；root 人工/应用账号分权同 dev 口径） ----
MICRO_DSN_IDENTITY=user:pass@tcp(<cloud-mysql>:3306)/micro_identity?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_PARTY=user:pass@tcp(<cloud-mysql>:3306)/micro_party?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_CATALOG=user:pass@tcp(<cloud-mysql>:3306)/micro_catalog?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_INVENTORY=user:pass@tcp(<cloud-mysql>:3306)/micro_inventory?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_DEVICE=user:pass@tcp(<cloud-mysql>:3306)/micro_device?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_NOTIFICATION=user:pass@tcp(<cloud-mysql>:3306)/micro_notification?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_ORDER=user:pass@tcp(<cloud-mysql>:3306)/micro_order?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_FINANCE=user:pass@tcp(<cloud-mysql>:3306)/micro_finance?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_CONTRACT=user:pass@tcp(<cloud-mysql>:3306)/micro_contract?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_STATION=user:pass@tcp(<cloud-mysql>:3306)/micro_station?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_OPS=user:pass@tcp(<cloud-mysql>:3306)/micro_ops?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_AUDIT=user:pass@tcp(<cloud-mysql>:3306)/micro_audit?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_FILE=user:pass@tcp(<cloud-mysql>:3306)/micro_file?charset=utf8mb4&parseTime=true&loc=Local
MICRO_DSN_ANALYTICS=user:pass@tcp(<cloud-mysql>:3306)/micro_analytics?charset=utf8mb4&parseTime=true&loc=Local

# ---- Redis 云托管（sessionx DB4：identity 唯一读写方） ----
REDIS_HOSTS=<cloud-redis>:6379

# ---- 对象存储（MinIO→云 OSS，B1） ----
OSS_ENDPOINT=<oss-endpoint>
OSS_BUCKET=micro-prod

# ---- TDengine（ECS-2 容器内；生产必改默认密码） ----
MICRO_TDENGINE_PW=<strong-password>

# ---- EMQX 双账号（S6 分权，容器内 bootstrap） ----
MICRO_EMQX_DASHBOARD_USER=admin
MICRO_EMQX_DASHBOARD_PW=<strong-password>
MICRO_EMQX_DEVICE_USER=micro-prod-device
MICRO_EMQX_DEVICE_PW=<strong-password>
MICRO_EMQX_PLATFORM_USER=micro-prod-platform
MICRO_EMQX_PLATFORM_PW=<strong-password>

# ---- 密钥三件套（keygen 产出，deploy/conf/keys 出库管理；ECS-1 ./keys bind mount） ----
# JWT RS256 / OTA Ed25519 / 数据 AES-256-GCM（kid 轮换语义见 keys.json Notes）
